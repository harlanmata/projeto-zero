<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title><%=e.code%> - Wprinter</title><link rel="stylesheet" href="/static/style.css"></head><body><header><b>WPRINTER</b><span>Assistente Técnico</span><a href="/">Nova consulta</a></header><main><a href="/">← Voltar</a><h1><%=e.code%></h1><p><b><%=e.brand%> <%=e.model%></b></p><div class="detail"><article><h3>Descrição</h3><p><%=e.description%></p></article><article><h3>Causa provável</h3><p><%=e.cause%></p></article><article><h3>Procedimento de diagnóstico</h3><p><%=e.procedure%></p></article><article><h3>Observações</h3><p><%=e.observations%></p></article></div><h2>Peças relacionadas</h2><table><tr><th>Part Number</th><th>Peça</th><th>Categoria</th></tr><%parts.forEach(p=>{%><tr><td><%=p.part_number%></td><td><%=p.part_name%></td><td><%=p.category%></td></tr><%})%></table></main></body></html>

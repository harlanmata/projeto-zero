<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Wprinter Assistente Técnico</title><link rel="stylesheet" href="/static/style.css"></head><body><header><b>WPRINTER</b><span>Assistente Técnico Web</span><a href="/admin">Cadastro técnico</a></header><main><section class="hero"><h1>Consulta técnica</h1><p>Pesquise códigos, modelos e descrições.</p><form><input name="q" placeholder="Código ou descrição" value="<%=q%>"><input name="brand" placeholder="Marca" value="<%=brand%>"><input name="model" placeholder="Modelo" value="<%=model%>"><button>Pesquisar</button></form></section><section><h2>Resultados (<%=errors.length%>)</h2><div class="grid"><% errors.forEach(e=>{%><a class="card" href="/erro/<%=e.id%>"><strong><%=e.code%></strong><span><%=e.brand%> <%=e.model%></span><p><%=e.description%></p></a><%})%></div></section></main></body></html>
